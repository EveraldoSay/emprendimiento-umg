# ==============================================================
# CyberSec AI Platform — Variables de Entorno
# Copia este archivo a .env y ajusta los valores.
# NUNCA subas .env a control de versiones.
# ==============================================================

# --- Aplicación ---
APP_NAME="CyberSec AI Platform"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# --- Base de Datos ---
DATABASE_URL="postgresql+asyncpg://cybersec:cybersec@localhost:5432/cybersec"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Para Docker Compose (Postgres service):
POSTGRES_PASSWORD=cybersec

# --- Redis ---
REDIS_URL="redis://:cybersec@localhost:6379/0"
REDIS_PASSWORD=cybersec
REDIS_CACHE_TTL=300

# --- JWT ---
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- 2FA / OTP ---
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# --- Cifrado Fernet ---
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY="CHANGE_ME_GENERATE_WITH_FERNET_GENERATE_KEY"

# --- Email SMTP (Gmail) ---
# Para Gmail: activa "Verificación en 2 pasos" y genera una App Password en:
# https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="deleonedvin94@gmail.com"
SMTP_PASSWORD="tu-app-password-de-16-caracteres"
SMTP_FROM="deleonedvin94@gmail.com"
SMTP_TLS=true

# --- CORS ---
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# --- Ollama (IA Soberana) ---
OLLAMA_BASE_URL="http://ollama:11434"
OLLAMA_DEFAULT_MODEL="llama3"
OLLAMA_TIMEOUT_SECONDS=120

# --- Celery ---
CELERY_BROKER_URL="redis://:cybersec@localhost:6379/1"
CELERY_RESULT_BACKEND="redis://:cybersec@localhost:6379/2"

# --- Amazon S3 (opcional) ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_REGION="us-east-1"

# --- Nmap ---
NMAP_PATH="/usr/bin/nmap"
NVD_API_KEY=""
NVD_BASE_URL="https://services.nvd.nist.gov/rest/json/cves/2.0"

# --- Reportes ---
REPORTS_DIR="/app/reports"

# --- Rate Limiting ---
RATE_LIMIT_AUTH="5/minute"
RATE_LIMIT_API="100/minute"

# --- SuperAdmin Inicial ---
# Este usuario se crea al ejecutar el seed
FIRST_SUPERADMIN_EMAIL="deleonedvin94@gmail.com"
FIRST_SUPERADMIN_PASSWORD="CyberSec2025!"
