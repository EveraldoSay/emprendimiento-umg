# ==============================================================
# .gitignore — CyberSec AI Platform
# ==============================================================

# Secretos y configuración local
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Alembic versiones generadas automáticamente
backend/migrations/versions/*.py

# Reportes generados
backend/reports/

# Node
node_modules/
frontend/dist/
frontend/.vite/
.npm

# Docker
*.log
docker/nginx/certs/*.pem
docker/nginx/certs/*.key
docker/nginx/certs/*.crt

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Ollama models (muy grandes)
# (se descargan en el contenedor, no se versiona)
