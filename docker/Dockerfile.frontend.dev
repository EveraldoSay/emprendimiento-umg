# ==============================================================
# CyberSec AI Platform — Frontend Dockerfile (desarrollo)
# Hot-reload con Vite
# ==============================================================

FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --legacy-peer-deps

COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
