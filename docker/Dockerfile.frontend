# ==============================================================
# CyberSec AI Platform — Frontend Dockerfile (producción)
# Build multi-stage: Node.js → Nginx static
# ==============================================================

FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --legacy-peer-deps

COPY . .
RUN npm run build

# Stage final: solo los archivos estáticos
FROM alpine:3.20 AS dist

COPY --from=builder /app/dist /app/dist

# El volumen frontend_dist lo comparte con Nginx
VOLUME /app/dist
CMD ["sh", "-c", "cp -r /app/dist/* /dist/ && echo 'Frontend build copied'"]
